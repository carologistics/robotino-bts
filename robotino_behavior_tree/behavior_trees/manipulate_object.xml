<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="ManipulateObject">
    <RetryUntilSuccessful num_attempts="5">
      <Sequence>
        <ScriptCondition code="action == &apos;pick&apos; || action == &apos;put&apos;"/>
         <Switch2 variable="{action}" case_1="pick" case_2="put">
	   <Sequence>
             <Script code="gripper_home_z := 0.08" />
             <SetGripper action_name="gigatino/gripper"
                  open="true"
                  status_code="{gripper_status_code}"
                  message="{gripper_message}" />
	   </Sequence>
           <Script code="gripper_home_z := 0.035" />
           <AlwaysFailure />
         </Switch2>
        <SubTree ID="MoveGripperToReferenced"
                 frame="end_effector_home"
                 x="0.0"
                 y="0.0"
                 z="{gripper_home_z}"/>
        <RetryUntilSuccessful num_attempts="3">
          <NavigateTo action_name="navigate_to_pose"
                      frame_id="{machine_input_tf}"
                      x="0.0"
                      y="0.0"
                      yaw="0.0"/>
        </RetryUntilSuccessful>
        <Switch2 variable="{action}" case_1="pick" case_2="put">
          <GrayBoxAlign action_name="gray_box_align_action"
                        timeout="20.0"
                        speed="0.1"/>
          <AlwaysSuccess/>
          <AlwaysFailure/>
        </Switch2>
        <MoveToShelf action_name="move_to_shelf_action"
                     timeout="10.0"
                     speed="0.1"/>
        <Switch2 case_1="pick"
                 case_2="put"
                 variable="{action}">
          <SubTree ID="PickBox"
                   _autoremap="true"/>
          <SubTree ID="PutBox"
                   _autoremap="true"/>
          <AlwaysFailure/>
        </Switch2>
        <RetryUntilSuccessful num_attempts="2">
          <MotorMove action_name="motor_move_action"
                     frame_id="base_link"
                     x="-0.5"
                     y="0.0"
                     z="0.0"
                     yaw="0.0"/>
        </RetryUntilSuccessful>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
