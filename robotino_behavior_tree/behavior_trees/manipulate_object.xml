<root BTCPP_format="4">
  <BehaviorTree ID="ManipulateObject">
    <RetryUntilSuccessful num_attempts="3">
      <Sequence>
        <ScriptCondition code="machine_input_tf != '' &amp;&amp; reference_frame != ''" />
        <ScriptCondition code="object_type == 'eurobox' || object_type == 'lego'" />
        <ScriptCondition code="action == 'pick' || action == 'put'" />

        <Switch2 variable="{object_type}" case_1="eurobox" case_2="lego">
          <Sequence>
            <Script code="object_prompt := 'grey plastic box'; segmentation_confidence := 0.05; gripper_home_z := 0.035; target_color := ''" />
          </Sequence>
          <Sequence>
            <!-- TODO: add lego_type again if subtype-specific grasping or detection becomes necessary. -->
            <ScriptCondition code="lego_color == 'green' || lego_color == 'blue' || lego_color == 'red' || lego_color == 'yellow'" />
            <Script code="object_prompt := 'toy brick'; segmentation_confidence := 0.1; gripper_home_z := 0.1; target_color := lego_color" />
          </Sequence>
          <AlwaysFailure />
        </Switch2>

        <RetryUntilSuccessful num_attempts="3">
          <MoveGripperTo action_name="gigatino/move"
                         frame="end_effector_home"
                         x="0.0"
                         y="0.0"
                         z="{gripper_home_z}" />
        </RetryUntilSuccessful>

        <!-- <RetryUntilSuccessful num_attempts="3">
          <NavigateTo
            frame_id="{machine_input_tf}"
            x="0.0"
            y="0.0"
            yaw="0.0" />
        </RetryUntilSuccessful> -->

        <RetryUntilSuccessful num_attempts="3">
          <ToggleObjectTracking
            object_prompt="{object_prompt}"
            reference_frame="{reference_frame}"
            distance_threshold="3.0"
            segmentation_confidence="{segmentation_confidence}"
            target_color="{target_color}"
            object_tf_name="tracked_object" />
        </RetryUntilSuccessful>

        <Sleep msec="500"/>
        <!-- tracked_object_approach encodes the stand-off distance and faces the object. -->
        <RetryUntilSuccessful num_attempts="3">
          <MotorMove action_name="motor_move_action"
                     frame_id="tracked_object_approach"
                     x="0.0"
                     y="0.0"
                     yaw="0.0" />
        </RetryUntilSuccessful>

        <Switch2 variable="{action}" case_1="pick" case_2="put">
          <Switch2 variable="{object_type}" case_1="eurobox" case_2="lego">
            <RetryUntilSuccessful num_attempts="3">
              <SubTree ID="PickBox" _autoremap="true" />
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="3">
              <SubTree ID="PickLego" _autoremap="true" />
            </RetryUntilSuccessful>
            <AlwaysFailure />
          </Switch2>
          <Switch2 variable="{object_type}" case_1="eurobox" case_2="lego">
            <RetryUntilSuccessful num_attempts="3">
              <SubTree ID="PutBox" _autoremap="true" />
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="3">
              <SubTree ID="PutLego" _autoremap="true" />
            </RetryUntilSuccessful>
            <AlwaysFailure />
          </Switch2>
          <AlwaysFailure />
        </Switch2>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
