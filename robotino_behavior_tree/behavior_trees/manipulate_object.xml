<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="ManipulateObject">
    <RetryUntilSuccessful num_attempts="3">
      <Sequence>
        <ScriptCondition code="machine_input_tf != '' &amp;&amp; reference_frame != ''" />
        <ScriptCondition code="object_type == 'eurobox' || object_type == 'lego'" />
        <ScriptCondition code="action == 'pick' || action == 'put'" />

        <Switch2 variable="{object_type}" case_1="eurobox" case_2="lego">
          <Sequence>
            <Switch2 variable="{action}" case_1="pick" case_2="put">
              <Script code="object_prompt := 'grey plastic box'; segmentation_confidence := 0.05; gripper_home_z := 0.035; target_color := ''" />
              <Script code="object_prompt := 'grey plastic box'; segmentation_confidence := 0.05; gripper_home_z := 0.14; target_color := ''" />
              <AlwaysFailure />
            </Switch2>
          </Sequence>
          <Sequence>
            <!-- TODO: add lego_type again if subtype-specific grasping or detection becomes necessary. -->
            <ScriptCondition code="lego_color == 'green' || lego_color == 'blue' || lego_color == 'red' || lego_color == 'yellow'" />
            <Script code="object_prompt := 'toy brick'; segmentation_confidence := 0.1; gripper_home_z := 0.1; target_color := lego_color" />
          </Sequence>
          <AlwaysFailure />
        </Switch2>

        <!-- Position Gripper -->
        <SubTree ID="MoveGripperToReferenced"
                 frame="end_effector_home"
                 x="0.0"
                 y="0.0"
                 z="{gripper_home_z}"
               z_override_in_end_effector_home="" />

        <!-- Navigate (and Detect Object if Picking) -->
        <RetryUntilSuccessful num_attempts="3">
          <Sequence>
            <!-- <NavigateTo
              frame_id="{machine_input_tf}"
              x="0.0"
              y="0.0"
              yaw="0.0" /> -->
            <Switch2 variable="{action}" case_1="pick" case_2="put">
              <AcquireObjectTracking
                action_name="acquire_object_tracking"
                object_prompt="{object_prompt}"
                reference_frame="{reference_frame}"
                distance_threshold="3.50"
                approach_distance="0.25"
                segmentation_confidence="{segmentation_confidence}"
                target_color="{target_color}"
                object_tf_name="tracked_object"
                approach_tf_name="tracked_object_approach"
                timeout_sec="20.0"
                min_stable_frames="1"
                max_position_jump="0.15"
                success="{object_acquisition_success}"
                error="{object_acquisition_error}"
                acquired_object_tf_name="{acquired_object_tf_name}"
                acquired_approach_tf_name="{acquired_approach_tf_name}" />
              <AlwaysSuccess />
              <AlwaysFailure />
            </Switch2>
          </Sequence>
        </RetryUntilSuccessful>

        <!-- Motor Move to the Object/Shelf -->
        <Switch2 variable="{action}" case_1="pick" case_2="put">
          <RetryUntilSuccessful num_attempts="3">
            <MotorMove action_name="motor_move_action"
                      frame_id="tracked_object_approach"
                      x="0.0"
                      y="0.0"
                      yaw="0.0" />
          </RetryUntilSuccessful>
          <RetryUntilSuccessful num_attempts="2">
            <MotorMove action_name="motor_move_action"
                       frame_id="base_link"
                       x="0.3"
                       y="0.0"
                       yaw="0.0" />
          </RetryUntilSuccessful>
          <AlwaysFailure />
        </Switch2>

        <!-- (Detect Object and Pick) or Put the Object -->
        <Switch2 variable="{action}" case_1="pick" case_2="put">
          <Sequence>
            <AcquireObjectTracking
              action_name="acquire_object_tracking"
              object_prompt="{object_prompt}"
              reference_frame="{reference_frame}"
              distance_threshold="3.50"
              approach_distance="0.25"
              segmentation_confidence="{segmentation_confidence}"
              target_color="{target_color}"
              object_tf_name="tracked_object"
              approach_tf_name="tracked_object_approach"
              timeout_sec="20.0"
              min_stable_frames="1"
              max_position_jump="0.15"
              success="{object_acquisition_success}"
              error="{object_acquisition_error}"
              acquired_object_tf_name="{acquired_object_tf_name}"
              acquired_approach_tf_name="{acquired_approach_tf_name}" />
            <Switch2 variable="{object_type}" case_1="eurobox" case_2="lego">
              <RetryUntilSuccessful num_attempts="3">
                <SubTree ID="PickBox" _autoremap="true" />
              </RetryUntilSuccessful>
              <RetryUntilSuccessful num_attempts="3">
                <SubTree ID="PickLego" _autoremap="true" />
              </RetryUntilSuccessful>
              <AlwaysFailure />
            </Switch2>
          </Sequence>
          <Switch2 variable="{object_type}" case_1="eurobox" case_2="lego">
            <RetryUntilSuccessful num_attempts="3">
              <SubTree ID="PutBox" _autoremap="true" />
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="3">
              <SubTree ID="PutLego" _autoremap="true" />
            </RetryUntilSuccessful>
            <AlwaysFailure />
          </Switch2>
          <AlwaysFailure />
        </Switch2>

        <!-- Motor Move Backwards -->
        <RetryUntilSuccessful num_attempts="2">
          <MotorMove action_name="motor_move_action"
                     frame_id="base_link"
                     x="-0.5"
                     y="0.0"
                     yaw="0.0" />
        </RetryUntilSuccessful>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
