<root BTCPP_format="4">
  <BehaviorTree ID="RobotinoDemo">
    <Sequence>
      <MotorMove action_name="motor_move_action"
                 frame_id="base_link"
                 x="1.0"
                 y="0.0"
                 yaw="0.0"/>

      <MoveGripperTo action_name="gigatino/move"
                     frame="base_link"
                     x="0.25"
                     y="0.0"
                     z="0.12"/>

      <NavigateTo
        frame_id="map"
        x="1.5"
        y="2.0"
        yaw="1.57"
        current_pose="{current_pose}"
        navigation_time="{navigation_time}"
        estimated_time_remaining="{estimated_time_remaining}"
        number_of_recoveries="{number_of_recoveries}"
        distance_remaining="{distance_remaining}"
        error_code="{error_code}"
        error_msg="{error_msg}" />
    </Sequence>
  </BehaviorTree>
</root>
