<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="GripperRoutine">
    <Sequence>
      <MoveGripperTo action_name="gigatino/move"
                     frame="end_effector_home"
                     x="0.1"
                     y="0.0"
                     z="0.1"
                     status_code="{move_status_code}"
                     message="{move_message}"/>
      <SetGripper action_name="gigatino/gripper"
                  open="false"
                  status_code="{gripper_status_code}"
                  message="{gripper_message}"/>
    </Sequence>
  </BehaviorTree>
</root>
