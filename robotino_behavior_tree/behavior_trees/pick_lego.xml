<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="PickLego">
    <Sequence>
      <SetGripper action_name="gigatino/gripper"
                  open="true"
                  status_code="{gripper_status_code}"
                  message="{gripper_message}" />
      <SubTree ID="MoveGripperToReferenced"
               frame="end_effector_home"
               x="0.0"
               y="0.0"
               z="0.12" />
      <!-- tracked_object offset directions:
           x higher = grabs further left
           y higher = grabs lower
           z higher = grabs further away from the robot
      -->
      <SubTree ID="MoveGripperToReferenced"
               frame="tracked_object"
               x="0.0"
               y="-0.024"
               z="-0.03" />
      <SetGripper action_name="gigatino/gripper"
                  open="false"
                  status_code="{gripper_status_code}"
                  message="{gripper_message}" />
      <Sleep msec="200" />
      <SubTree ID="MoveGripperToReferenced"
               frame="gripper_end_effector"
               x="0.0"
               y="0.0"
               z="0.03" />
      <SubTree ID="MoveGripperToReferenced"
               frame="end_effector_home"
               x="0.0"
               y="0.0"
               z="0.12" />
    </Sequence>
  </BehaviorTree>
</root>
