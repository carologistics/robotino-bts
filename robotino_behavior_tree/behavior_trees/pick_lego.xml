<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="PickLego">
    <Sequence>
      <SetGripper action_name="gigatino/gripper"
                  open="true"
                  status_code="{gripper_status_code}"
                  message="{gripper_message}" />
      <SubTree ID="MoveGripperToReferenced"
               frame="end_effector_home"
               x="0.0"
               y="0.0"
               z="0.12"
               z_override_in_end_effector_home="" />
      <!-- tracked_object offset directions:
           x higher = grabs further left
           y higher = grabs lower
           z higher = grabs further away from the robot
      -->
      <Script code="lego_pick_x := object_end_effector_home_x; lego_pick_y := object_end_effector_home_y - 0.024; lego_pick_z := object_end_effector_home_z - 0.03" />
      <SubTree ID="MoveGripperToReferenced"
               frame="end_effector_home"
               x="{lego_pick_x}"
               y="{lego_pick_y}"
               z="{lego_pick_z}"
               z_override_in_end_effector_home="" />
      <SetGripper action_name="gigatino/gripper"
                  open="false"
                  status_code="{gripper_status_code}"
                  message="{gripper_message}" />
      <Sleep msec="200" />
      <SubTree ID="MoveGripperToReferenced"
               frame="gripper_end_effector"
               x="0.0"
               y="0.0"
               z="0.03"
               z_override_in_end_effector_home="" />
      <SubTree ID="MoveGripperToReferenced"
               frame="end_effector_home"
               x="0.0"
               y="0.0"
               z="0.12"
               z_override_in_end_effector_home="" />
    </Sequence>
  </BehaviorTree>
</root>
