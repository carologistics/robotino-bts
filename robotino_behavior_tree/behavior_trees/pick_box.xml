<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="PickBox">
    <Sequence>
      <SetGripper action_name="gigatino/gripper"
                     open="true"
                     status_code="{gripper_status_code}"
                     message="{gripper_message}"/>
      <MoveGripperTo action_name="gigatino/move"
                     frame="end_effector_home"
                     x="0.0"
                     y="0.0"
                     z="0.055"
                     status_code="{move_status_code}"
                     message="{move_message}"/>
      <MoveGripperTo action_name="gigatino/move"
                     frame="tracked_object"
                     x="0.0"
                     y="-0.035"
                     z="-0.02"
                     status_code="{move_status_code}"
                     message="{move_message}"/> 
      <SetGripper action_name="gigatino/gripper"
                     open="false"
                     status_code="{gripper_status_code}"
                     message="{gripper_message}"/>
      <MoveGripperTo action_name="gigatino/move"
                     frame="gripper_end_effector"
                     x="0.0"
                     y="0.0"
                     z="0.05"
                     status_code="{move_status_code}"
                     message="{move_message}"/>
      <MoveGripperTo action_name="gigatino/move"
                     frame="end_effector_home"
                     x="0.0"
                     y="0.0"
                     z="0.1"
                     status_code="{move_status_code}"
                     message="{move_message}"/> 
    </Sequence>
  </BehaviorTree>
</root>
