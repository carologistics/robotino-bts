<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="MoveGripperToReferenced">
    <RetryUntilSuccessful num_attempts="3">
      <Sequence>
        <MoveGripperTo action_name="gigatino/move"
                       frame="{frame}"
                       x="{x}"
                       y="{y}"
                       z="{z}"
                       status_code="{move_status_code}"
                       message="{move_message}" />
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
